 "data": {
  "name": "dataset"
 },
 "transform": [
  {
   "calculate": "isValid(datum.Value) ? toNumber(datum.Value) : 0",
   "as": "__value"
  },
  {
   "window": [
    {
     "op": "rank",
     "as": "__valueRank"
    }
   ],
   "sort": [
    {
     "field": "__value",
     "order": "descending"
    }
   ]
  },
  {
   "calculate": "datum.__valueRank > maxBars",
   "as": "__isOther"
  },
  {
   "calculate": "datum.__isOther ? otherLabel : datum.Category",
   "as": "__groupKey"
  },
  {
   "joinaggregate": [
    {
     "op": "sum",
     "field": "__value",
     "as": "__groupValue"
    }
   ],
   "groupby": [
    "__groupKey"
   ]
  },
  {
   "calculate": "isValid(datum.Target) && isFinite(toNumber(datum.Target))",
   "as": "__targetRowValid"
  },
  {
   "calculate": "datum.__targetRowValid ? toNumber(datum.Target) : 0",
   "as": "__targetRowNum"
  },
  {
   "calculate": "datum.__targetRowValid ? 1 : 0",
   "as": "__targetRowValidNum"
  },
  {
   "joinaggregate": [
    {
     "op": "sum",
     "field": "__targetRowNum",
     "as": "__groupTargetSum"
    },
    {
     "op": "max",
     "field": "__targetRowValidNum",
     "as": "__groupTargetHasAny"
    }
   ],
   "groupby": [
    "__groupKey"
   ]
  },
  {
   "window": [
    {
     "op": "rank",
     "as": "__pickRank"
    }
   ],
   "groupby": [
    "__groupKey"
   ],
   "sort": [
    {
     "field": "__value",
     "order": "descending"
    }
   ]
  },
  {
   "filter": "datum.__pickRank == 1"
  },
  {
   "joinaggregate": [
    {
     "op": "sum",
     "field": "__groupValue",
     "as": "__totalValue"
    }
   ]
  },
  {
   "calculate": "datum.__totalValue != 0 ? datum.__groupValue / datum.__totalValue : 0",
   "as": "__pct"
  },
  {
   "calculate": "format(datum.__groupValue, ',.0f')",
   "as": "__valueText"
  },
  {
   "calculate": "format(datum.__pct, '.1%')",
   "as": "__pctText"
  },
  {
   "calculate": "showPercent ? datum.__valueText + ' (' + datum.__pctText + ')' : datum.__valueText",
   "as": "__labelText"
  },
  {
   "calculate": "length(datum.__labelText)",
   "as": "__labelLen"
  },
  {
   "calculate": "length(datum.__groupKey)",
   "as": "__nameLen"
  },
  {
   "joinaggregate": [
    {
     "op": "max",
     "field": "__labelLen",
     "as": "__maxLabelLen"
    },
    {
     "op": "max",
     "field": "__nameLen",
     "as": "__maxNameLen"
    }
   ]
  },
  {
   "joinaggregate": [
    {
     "op": "min",
     "field": "__groupValue",
     "as": "__sortMinV"
    },
    {
     "op": "max",
     "field": "__groupValue",
     "as": "__sortMaxV"
    }
   ]
  },
  {
   "calculate": "(datum.__sortMaxV - datum.__sortMinV) != 0 ? (datum.__sortMaxV - datum.__sortMinV) : 1",
   "as": "__sortSpan"
  },
  {
   "calculate": "clamp((datum.__groupValue - datum.__sortMinV) / datum.__sortSpan, 0, 1)",
   "as": "__sortFrac"
  },
  {
   "calculate": "indexof(customOrder, datum.__groupKey)",
   "as": "__customIdx"
  },
  {
   "calculate": "datum.__isOther ? '2' : (sortMode == 'custom' ? (datum.__customIdx >= 0 ? '0_' + format(datum.__customIdx, '020.4f') : '1_' + format(1 - datum.__sortFrac, '.12f')) : sortMode == 'nameAsc' ? '0_' + datum.__groupKey : sortMode == 'valueAsc' ? '0_' + format(datum.__sortFrac, '.12f') : '0_' + format(1 - datum.__sortFrac, '.12f'))",
   "as": "__sortKey"
  },
  {
   "window": [
    {
     "op": "row_number",
     "as": "__barRank"
    }
   ],
   "sort": [
    {
     "field": "__sortKey",
     "order": "ascending"
    }
   ]
  },
  {
   "joinaggregate": [
    {
     "op": "max",
     "field": "__barRank",
     "as": "__barCount"
    }
   ]
  },
  {
   "joinaggregate": [
    {
     "op": "max",
     "field": "__groupValue",
     "as": "__maxGroupValue"
    },
    {
     "op": "min",
     "field": "__groupValue",
     "as": "__minGroupValue"
    }
   ]
  },
  {
   "calculate": "datum.__groupTargetHasAny == 1 ? datum.__groupTargetSum : -1e15",
   "as": "__targetForMaxCand"
  },
  {
   "calculate": "datum.__groupTargetHasAny == 1 ? datum.__groupTargetSum : 1e15",
   "as": "__targetForMinCand"
  },
  {
   "joinaggregate": [
    {
     "op": "max",
     "field": "__targetForMaxCand",
     "as": "__maxTargetForDomain"
    },
    {
     "op": "min",
     "field": "__targetForMinCand",
     "as": "__minTargetForDomain"
    }
   ]
  },
  {
   "calculate": "(targetMode != 'none' && datum.__maxTargetForDomain > -1e14) ? max(datum.__maxGroupValue, datum.__maxTargetForDomain) : datum.__maxGroupValue",
   "as": "__rawMax"
  },
  {
   "calculate": "(targetMode != 'none' && datum.__minTargetForDomain < 1e14) ? min(datum.__minGroupValue, datum.__minTargetForDomain) : datum.__minGroupValue",
   "as": "__rawMin"
  },
  {
   "calculate": "max(0, datum.__rawMax)",
   "as": "__domainMaxBase"
  },
  {
   "calculate": "min(0, datum.__rawMin)",
   "as": "__domainMinBase"
  },
  {
   "calculate": "axisMode == 'zero' ? datum.__domainMaxBase : (datum.__domainMaxBase * (1 + 0.12))",
   "as": "__domainMax"
  },
  {
   "calculate": "axisMode == 'zero' ? datum.__domainMinBase : (datum.__domainMinBase < 0 ? datum.__domainMinBase * (1 + 0.12) : 0)",
   "as": "__domainMin"
  },
  {
   "calculate": "((datum.__domainMax) - (datum.__domainMin)) != 0 ? ((datum.__domainMax) - (datum.__domainMin)) : 1",
   "as": "__domainSpan"
  },
  {
   "calculate": "axisMode == 'hide' ? 0 : 14",
   "as": "__axisZoneH"
  },
  {
   "calculate": "height - datum.__axisZoneH",
   "as": "__plotBottom"
  },
  {
   "calculate": "datum.__plotBottom / max(datum.__barCount, 1)",
   "as": "__rowH"
  },
  {
   "calculate": "clamp(barThickness, 0.3, 1.0)",
   "as": "__barThicknessClamped"
  },
  {
   "calculate": "datum.__rowH * datum.__barThicknessClamped",
   "as": "__barH"
  },
  {
   "calculate": "(datum.__barRank - 0.5) * datum.__rowH",
   "as": "__barYCenter"
  },
  {
   "calculate": "datum.__barYCenter - datum.__barH / 2",
   "as": "__barTop"
  },
  {
   "calculate": "datum.__barYCenter + datum.__barH / 2",
   "as": "__barBottom"
  },
  {
   "calculate": "clamp(datum.__rowH * 0.5, 9, 20)",
   "as": "__nameFontSizeAuto"
  },
  {
   "calculate": "datum.__nameFontSizeAuto * fontScale * nameFontScale",
   "as": "__nameFontSize"
  },
  {
   "calculate": "clamp(datum.__rowH * 0.45, 9, 18)",
   "as": "__labelFontSizeAutoOutside"
  },
  {
   "calculate": "min(clamp(datum.__rowH * 0.45, 9, 18), datum.__barH * 0.75)",
   "as": "__labelFontSizeAutoInside"
  },
  {
   "calculate": "datum.__maxNameLen * 0.62 * datum.__nameFontSize",
   "as": "__nameZoneWRaw"
  },
  {
   "calculate": "min(datum.__nameZoneWRaw, width * 0.35)",
   "as": "__nameZoneW"
  },
  {
   "calculate": "4 + datum.__nameZoneW + 8",
   "as": "__plotLeftBase"
  },
  {
   "calculate": "datum.__maxLabelLen * 0.60 * datum.__labelFontSizeAutoOutside + 6 * 2",
   "as": "__labelZoneWCandOutside"
  },
  {
   "calculate": "datum.__domainMinBase < 0",
   "as": "__hasNegative"
  },
  {
   "calculate": "width - datum.__plotLeftBase - 8 - datum.__labelZoneWCandOutside - (datum.__hasNegative ? datum.__labelZoneWCandOutside : 0)",
   "as": "__plotWidthIfOutside"
  },
  {
   "calculate": "valueLabel == 'none' ? 'none' : (valueLabel == 'inside' ? 'inside' : (datum.__plotWidthIfOutside >= width * 0.15 ? 'outside' : 'inside'))",
   "as": "__effLabelMode"
  },
  {
   "calculate": "datum.__plotLeftBase + ((datum.__hasNegative && datum.__effLabelMode == 'outside') ? datum.__labelZoneWCandOutside : 0)",
   "as": "__plotLeft"
  },
  {
   "calculate": "width - 8 - (datum.__effLabelMode == 'outside' ? datum.__labelZoneWCandOutside : 0)",
   "as": "__plotRight"
  },
  {
   "calculate": "(datum.__plotLeft + ((0) - (datum.__domainMin)) / (datum.__domainSpan) * ((datum.__plotRight) - (datum.__plotLeft)))",
   "as": "__barX0"
  },
  {
   "calculate": "(datum.__plotLeft + ((datum.__groupValue) - (datum.__domainMin)) / (datum.__domainSpan) * ((datum.__plotRight) - (datum.__plotLeft)))",
   "as": "__barX1"
  },
  {
   "calculate": "min(datum.__barX0, datum.__barX1)",
   "as": "__barXMin"
  },
  {
   "calculate": "max(datum.__barX0, datum.__barX1)",
   "as": "__barXMax"
  },
  {
   "calculate": "abs(datum.__barX1 - datum.__barX0)",
   "as": "__barPixelLen"
  },
  {
   "calculate": "datum.__groupValue >= 0",
   "as": "__barSignPos"
  },
  {
   "calculate": "(datum.__plotLeft + ((datum.__groupTargetSum) - (datum.__domainMin)) / (datum.__domainSpan) * ((datum.__plotRight) - (datum.__plotLeft)))",
   "as": "__targetX"
  },
  {
   "calculate": "datum.__groupTargetHasAny == 1",
   "as": "__groupTargetValid"
  },
  {
   "calculate": "datum.__groupValue >= datum.__groupTargetSum",
   "as": "__targetMet"
  },
  {
   "calculate": "datum.__groupTargetValid ? format(datum.__groupTargetSum, ',.0f') : '-'",
   "as": "__targetTooltipText"
  },
  {
   "calculate": "(targetMode == 'line' && datum.__groupTargetValid) ? (datum.__barSignPos ? max(datum.__barX1, datum.__targetX) : min(datum.__barX1, datum.__targetX)) : datum.__barX1",
   "as": "__outsideAnchor"
  },
  {
   "calculate": "datum.__barSignPos ? (datum.__outsideAnchor + 6) : (datum.__outsideAnchor - 6)",
   "as": "__labelXOutside"
  },
  {
   "calculate": "datum.__barSignPos ? 'left' : 'right'",
   "as": "__labelAlignOutside"
  },
  {
   "calculate": "datum.__barSignPos ? (datum.__barX1 - 6) : (datum.__barX1 + 6)",
   "as": "__labelXInside"
  },
  {
   "calculate": "datum.__barSignPos ? 'right' : 'left'",
   "as": "__labelAlignInside"
  },
  {
   "calculate": "datum.__labelLen * 0.60 * datum.__labelFontSizeAutoInside",
   "as": "__labelWidthEstimateInside"
  },
  {
   "calculate": "(datum.__labelWidthEstimateInside + 2 * 6) <= datum.__barPixelLen",
   "as": "__insideRoomOk"
  },
  {
   "calculate": "datum.__barSignPos ? (datum.__labelXInside - datum.__labelWidthEstimateInside) : datum.__labelXInside",
   "as": "__insideSpanNear"
  },
  {
   "calculate": "datum.__barSignPos ? datum.__labelXInside : (datum.__labelXInside + datum.__labelWidthEstimateInside)",
   "as": "__insideSpanFar"
  },
  {
   "calculate": "(targetMode == 'line' && datum.__groupTargetValid) && (datum.__targetX >= datum.__insideSpanNear - 2) && (datum.__targetX <= datum.__insideSpanFar + 2)",
   "as": "__targetHitsInsideLabel"
  },
  {
   "calculate": "datum.__insideRoomOk && !datum.__targetHitsInsideLabel",
   "as": "__insideFits"
  },
  {
   "calculate": "datum.__effLabelMode == 'none' ? '' : (datum.__effLabelMode == 'outside' ? datum.__labelText : (datum.__insideFits ? datum.__labelText : ''))",
   "as": "__labelDisplayText"
  },
  {
   "calculate": "datum.__effLabelMode == 'outside' ? datum.__labelXOutside : datum.__labelXInside",
   "as": "__labelDisplayX"
  },
  {
   "calculate": "datum.__effLabelMode == 'outside' ? datum.__labelAlignOutside : datum.__labelAlignInside",
   "as": "__labelDisplayAlign"
  },
  {
   "calculate": "(datum.__effLabelMode == 'outside' ? datum.__labelFontSizeAutoOutside : datum.__labelFontSizeAutoInside) * fontScale * labelFontScale",
   "as": "__labelDisplayFontSize"
  },
  {
   "calculate": "format(datum.__domainMin, ',.0f')",
   "as": "__axisMinText"
  },
  {
   "calculate": "format(datum.__domainMax, ',.0f')",
   "as": "__axisMaxText"
  },
  {
