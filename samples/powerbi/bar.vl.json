   "as": "__axisY"
  },
  {
   "calculate": "colorOverrides[datum.__groupKey] ? colorOverrides[datum.__groupKey] : (datum.__isOther ? otherColor : ((targetMode == 'color' && datum.__groupTargetValid) ? (datum.__targetMet ? targetColorOver : targetColorUnder) : (length(palette) > 0 ? palette[(datum.__barRank - 1) % length(palette)] : pbiColor(datum.__barRank - 1))))",
   "as": "__barColor"
  },
  {
   "calculate": "luminance(datum.__barColor) >= 0.45 ? '#252423' : '#FFFFFF'",
   "as": "__labelColorInside"
  }
 ],
