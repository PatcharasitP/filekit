  "information": {
   "name": "SiteScope Dynamic Bar",
   "description": "แท่งแนวนอน reusable ข้ามไฟล์ field contract ตายตัว 2 ช่องบังคับ Category (nominal, ชื่อกลุ่ม) และ Value (quantitative, ค่าความยาวแท่ง) บวก Target (quantitative, ไม่บังคับ — ลาก field เข้า field well เองแล้ว rename เป็น 'Target' ตรงตัว ไม่ผ่าน template wizard เพราะไม่บังคับ) วิธีใช้กับไฟล์อื่น: ลากคอลัมน์/measure เข้า field well ของ Deneb แล้ว Rename for this visual เป็น Category / Value ตามลำดับ สเปกจะทำงานทันทีโดยไม่ต้องแก้โค้ด % และยอดรวมคำนวณในสเปกเอง ไม่ต้องเตรียม measure % มาก่อน",
   "author": "ลุงเอ (Power BI + Deneb), งาน SiteScope_Donut",
   "uuid": "c7e1f0a3-7d2e-4b3f-9b4e-3f7d0c2b8c5f",
   "generated": "2026-09-11"
  },
  "dataset": [
   {
    "key": "Category",
    "name": "Category",
    "type": "text",
    "kind": "column"
   },
   {
    "key": "Value",
    "name": "Value",
    "type": "numeric",
    "kind": "measure"
   }
  ],
  "paramGuide": {
   "sortMode": "การเรียงลำดับแท่ง: 'valueDesc' มากไปน้อย (ค่าเริ่มต้น), 'valueAsc' น้อยไปมาก, 'nameAsc' เรียงตามชื่อ, 'custom' ใช้ customOrder — otherLabel ปักท้ายสุดเสมอทุกโหมด",
   "customOrder": "array ชื่อกลุ่มตามลำดับที่ต้องการ ใช้เมื่อ sortMode = custom เท่านั้น กลุ่มที่ไม่อยู่ในลิสต์นี้ต่อท้ายเรียงมากไปน้อย (ไม่หายไปเงียบ ๆ)",
   "maxBars": "จำนวนแท่งสูงสุดที่แสดงแยกกัน (3 ถึง 20) ที่เหลือถูกยุบรวมเป็นแท่งเดียวชื่อตาม otherLabel ปักท้ายสุดเสมอ",
   "otherLabel": "ชื่อกลุ่มที่ถูกยุบรวมเมื่อเกิน maxBars",
   "barThickness": "สัดส่วนความหนาแท่งต่อช่อง (0.3 ถึง 1.0) ยิ่งมากยิ่งหนา ที่เหลือเป็นช่องว่างระหว่างแท่ง",
   "cornerRadius": "มุมโค้งปลายแท่ง (พิกเซล, 0 ถึง 8) — โค้งทั้ง 4 มุมเท่ากัน (ไม่ได้แยกโค้งเฉพาะปลายไกล base เพื่อความง่าย ที่ค่า 0-8px ผลต่างมองแทบไม่เห็น)",
   "valueLabel": "ตำแหน่งป้ายตัวเลข: 'outside' ชิดนอกปลายแท่ง (ค่าเริ่มต้น, สลับเป็น inside เองอัตโนมัติถ้าพื้นที่ขวาไม่พอ), 'inside' ชิดในปลายแท่ง (ซ่อนอัตโนมัติถ้าแท่งสั้นเกินจะใส่ตัวเลขได้โดยไม่ล้น), 'none' ไม่แสดง",
   "showPercent": "true = ต่อท้ายป้ายตัวเลขด้วยสัดส่วนของยอดรวม เช่น '134 (70.5%)'",
   "palette": "array สี hex ของตัวเอง ไล่ตามลำดับแท่งหลัง sort ถ้าสีหมดก่อนแท่งหมดจะวนซ้ำ ปล่อยว่าง [] = ใช้สีตามธีมไฟล์แทน",
   "colorOverrides": "object ล็อกสีเจาะจงรายชื่อกลุ่ม ชนะทุกชั้น (รวมถึง targetMode='color') เช่น {\"A\":\"#1F4E79\"}",
   "otherColor": "สีของแท่งกลุ่มที่ถูกยุบ (otherLabel) โดยเฉพาะ ชนะ palette/targetMode='color'/ธีม (แต่แพ้ colorOverrides ถ้ามีคีย์ตรงกับ otherLabel)",
   "targetMode": "ใช้คอลัมน์ Target ยังไง: 'none' ไม่แตะ Target เลย (ค่าเริ่มต้น, ทำงานได้ปกติแม้ไม่มีคอลัมน์นี้), 'line' ขีดเส้นเป้าหมายบนแท่งแต่ละอัน, 'color' ระบายสีแท่งตามถึงเป้าหรือไม่ (ทับ palette แต่แพ้ colorOverrides/otherColor)",
   "targetColorOver": "สีแท่งเมื่อ Value ถึงหรือเกิน Target (ใช้เมื่อ targetMode = color เท่านั้น)",
   "targetColorUnder": "สีแท่งเมื่อ Value ไม่ถึง Target (ใช้เมื่อ targetMode = color เท่านั้น)",
   "axisMode": "แกนค่า: 'auto' ปล่อยตามข้อมูล (เผื่อที่ปลายไกลจาก 0 อีก 12% ให้ป้าย/เส้นเป้าหมายมีที่ยืน, เส้นฐาน 0 คงที่เสมอ), 'zero' บังคับพอดีค่าจริงไม่เผื่อที่เลย (แท่งยาวสุดชนขอบ plot), 'hide' ซ่อนป้ายแกนทั้งหมด (โดเมนคำนวณแบบเดียวกับ auto)",
   "fontScale": "ตัวคูณขนาดตัวอักษรทุกก้อนพร้อมกัน (0.6 ถึง 1.6) คูณทับขนาดที่คำนวณอัตโนมัติจากพื้นที่ ค่าเริ่มต้น 1 = ไม่เปลี่ยนอะไรเลย",
   "labelFontScale": "ตัวคูณเฉพาะป้ายตัวเลข (0.5 ถึง 2.0) คูณทับ fontScale อีกชั้น",
   "nameFontScale": "ตัวคูณเฉพาะชื่อกลุ่มด้านซ้าย (0.5 ถึง 2.0) คูณทับ fontScale อีกชั้น"
  },
  "colorMode": "production: ชั้นสีธีม default ใช้ pbiColor(index) จริงตามธีมไฟล์"
 },
