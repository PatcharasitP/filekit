{
  "definition": {
    "triggers": { "When_a_row_is_added": { "type": "OpenApiConnectionWebhook" } },
    "actions": {
      "Get_details": { "type": "OpenApiConnection", "runAfter": {} },
      "Notify_team": { "type": "OpenApiConnection", "runAfter": { "Get_details": ["Succeeded"] } },
      "Create_task": { "type": "OpenApiConnection", "runAfter": { "Get_details": ["Succeeded"] } },
      "Update_status": { "type": "OpenApiConnection", "runAfter": { "Notify_team": ["Succeeded"], "Create_task": ["Succeeded"] } },
      "Write_log": { "type": "Compose", "runAfter": { "Update_status": ["Succeeded", "Failed", "Skipped", "TimedOut"] } },
      "Retry_later": { "type": "Compose", "runAfter": { "Update_status": ["Skipped"] } }
    }
  }
}
