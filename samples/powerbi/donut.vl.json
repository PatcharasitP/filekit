   "name": "otherColor",
   "value": "#B3B0AD"
  },
  {
   "name": "donutThickness",
   "value": 0.28
  },
  {
   "name": "donutScale",
   "value": 0.67
  },
  {
   "name": "showPercent",
   "value": true
  },
  {
   "name": "legendLayout",
   "value": "inline"
  },
  {
   "name": "cornerRadius",
   "value": 3
  },
  {
   "name": "padAngle",
   "value": 0.006
  },
  {
   "name": "showSliceLabels",
   "value": false
  },
  {
   "name": "legendPosition",
   "value": "right"
  },
  {
   "name": "fontScale",
   "value": 1
  },
  {
   "name": "centerFontScale",
   "value": 1
  },
  {
   "name": "legendFontScale",
   "value": 1
  },
  {
   "name": "sliceLabelFontScale",
   "value": 1
  },
  {
   "name": "legendWCeiling",
   "expr": "width * 0.42"
  },
  {
   "name": "zoneGap",
   "expr": "16"
  },
  {
   "name": "ringMargin",
   "expr": "6"
  },
  {
   "name": "legendHCeiling",
   "expr": "height * 0.42"
  },
  {
   "name": "isSideLegend",
   "expr": "(legendPosition == 'left' || legendPosition == 'right')"
  },
  {
   "name": "isBandLegend",
   "expr": "(legendPosition == 'top' || legendPosition == 'bottom')"
  },
  {
   "name": "isNoLegend",
   "expr": "(legendPosition == 'none')"
  },
  {
   "name": "legendFontScaleEff",
   "expr": "fontScale * legendFontScale"
  },
  {
   "name": "centerFontScaleEff",
   "expr": "fontScale * centerFontScale"
  },
  {
   "name": "sliceLabelScaleEff",
   "expr": "fontScale * sliceLabelFontScale"
  },
  {
   "name": "roughMaxRByWidth",
   "expr": "isSideLegend ? (width - legendWCeiling - zoneGap) / 2 : width / 2"
  },
  {
   "name": "roughMaxRByHeight",
   "expr": "isBandLegend ? (height - legendHCeiling - zoneGap) / 2 : height / 2"
  },
  {
   "name": "roughOuterR",
   "expr": "max(10, donutScale * (min(roughMaxRByWidth, roughMaxRByHeight) - ringMargin))"
  },
  {
   "name": "fontCeilingFromDiameter",
   "expr": "2 * roughOuterR / 8"
  }
 ],
 "data": {
  "name": "dataset"
 },
 "transform": [
  {
   "calculate": "isValid(datum.Value) ? toNumber(datum.Value) : 0",
   "as": "__value"
  },
  {
   "window": [
    {
     "op": "rank",
     "as": "__valueRank"
    }
   ],
   "sort": [
    {
     "field": "__value",
     "order": "descending"
    }
   ]
  },
  {
   "calculate": "datum.__valueRank > maxSlices",
   "as": "__isOther"
  },
  {
   "calculate": "datum.__isOther ? 'อื่น ๆ' : datum.Category",
   "as": "__groupKey"
  },
  {
   "joinaggregate": [
    {
     "op": "sum",
     "field": "__value",
     "as": "__groupValue"
    }
   ],
   "groupby": [
    "__groupKey"
   ]
  },
  {
   "window": [
    {
     "op": "rank",
     "as": "__pickRank"
    }
   ],
   "groupby": [
    "__groupKey"
   ],
   "sort": [
    {
     "field": "__value",
     "order": "descending"
    }
   ]
  },
  {
   "filter": "datum.__pickRank == 1"
  },
  {
   "joinaggregate": [
    {
     "op": "sum",
     "field": "__groupValue",
     "as": "__totalValue"
    }
   ]
  },
  {
   "calculate": "datum.__totalValue > 0 ? datum.__groupValue / datum.__totalValue : 0",
   "as": "__pct"
  },
  {
   "calculate": "format(datum.__groupValue, ',.0f')",
   "as": "__countText"
  },
  {
   "calculate": "format(datum.__pct, '.1%')",
   "as": "__pctText"
  },
  {
   "calculate": "showPercent ? datum.__pctText : ''",
   "as": "__pctTextDisplay"
  },
  {
   "calculate": "datum.__countText + (showPercent ? ' (' + datum.__pctText + ')' : '')",
   "as": "__valueFullTextForWidth"
  },
  {
   "calculate": "length(datum.__groupKey)",
   "as": "__nameLen"
  },
  {
   "calculate": "length(datum.__valueFullTextForWidth)",
   "as": "__valueFullLen"
  },
  {
   "calculate": "length(datum.__countText)",
   "as": "__valueCountLen"
  },
  {
   "joinaggregate": [
    {
     "op": "max",
     "field": "__nameLen",
     "as": "__maxNameLen"
    },
    {
     "op": "max",
     "field": "__valueFullLen",
     "as": "__maxValueFullLen"
    },
    {
     "op": "max",
     "field": "__valueCountLen",
     "as": "__maxValueCountLen"
    }
   ]
  },
  {
   "calculate": "indexof(customOrder, datum.__groupKey)",
   "as": "__customIdx"
  },
  {
   "calculate": "datum.__isOther ? '2' : (sortMode == 'custom' ? (datum.__customIdx >= 0 ? '0_' + format(datum.__customIdx, '020.4f') : '1_' + format(1e15 - datum.__groupValue, '020.4f')) : sortMode == 'nameAsc' ? '0_' + datum.__groupKey : sortMode == 'valueAsc' ? '0_' + format(datum.__groupValue, '020.4f') : '0_' + format(1e15 - datum.__groupValue, '020.4f'))",
   "as": "__sortKey"
  },
  {
   "window": [
    {
     "op": "row_number",
     "as": "__legendRank"
    },
    {
     "op": "sum",
     "field": "__groupValue",
     "as": "__cumValue"
    }
   ],
   "sort": [
    {
     "field": "__sortKey",
     "order": "ascending"
    }
   ],
   "frame": [
    null,
    0
   ]
  },
  {
   "calculate": "datum.__totalValue > 0 ? (datum.__cumValue - datum.__groupValue) / datum.__totalValue * 2 * PI : 0",
   "as": "__thetaStart"
  },
  {
   "calculate": "datum.__totalValue > 0 ? datum.__cumValue / datum.__totalValue * 2 * PI : 0",
   "as": "__thetaEnd"
  },
  {
   "calculate": "(datum.__thetaStart + datum.__thetaEnd) / 2",
   "as": "__thetaMid"
  },
  {
   "joinaggregate": [
    {
     "op": "max",
     "field": "__legendRank",
     "as": "__legendCount"
    }
   ]
  },
  {
   "calculate": "max(datum.__legendCount, 1)",
   "as": "__displayCount"
  },
  {
   "joinaggregate": [
    {
     "op": "max",
     "field": "__groupValue",
     "as": "__maxGroupValue"
    },
    {
     "op": "argmax",
     "field": "__groupValue",
     "as": "__argmaxGroupRow"
    }
   ]
  },
  {
   "calculate": "max(datum.__legendCount, 1)",
   "as": "__legendRows"
  },
  {
   "calculate": "height / (datum.__legendRows * 11.5)",
   "as": "__heightFontSeed"
  },
  {
   "calculate": "legendHCeiling / 11.5",
   "as": "__heightFontSeedBand"
  },
  {
   "calculate": "clamp(min(isBandLegend ? datum.__heightFontSeedBand : datum.__heightFontSeed, fontCeilingFromDiameter), 9, 26)",
   "as": "__legendFontSizeAuto"
  },
  {
   "calculate": "datum.__legendFontSizeAuto * legendFontScaleEff",
   "as": "__legendFontSize"
  },
  {
   "calculate": "datum.__legendFontSize * 1.6",
   "as": "__legendRowH"
  },
  {
   "calculate": "max(30, pow(datum.__legendFontSize * 0.7895, 2))",
   "as": "__legendDotSize"
  },
  {
   "calculate": "(datum.__legendFontSize * 0.3)",
   "as": "__dotInset"
  },
  {
   "calculate": "(datum.__legendFontSize * 1.3)",
   "as": "__nameGap"
  },
  {
   "calculate": "(datum.__maxNameLen * 0.62 * datum.__legendFontSize)",
   "as": "__nameContentSlot"
  },
  {
   "calculate": "max(datum.__legendFontSize * 0.5, 6)",
   "as": "__colGap"
  },
  {
   "calculate": "(datum.__maxValueFullLen * 0.60 * datum.__legendFontSize)",
   "as": "__valueFullSlot"
  },
  {
   "calculate": "(datum.__maxValueCountLen * 0.60 * datum.__legendFontSize)",
   "as": "__valueCountSlot"
  },
  {
   "calculate": "(datum.__legendFontSize * 0.4)",
   "as": "__legendRightMargin"
  },
  {
   "calculate": "(datum.__dotInset + datum.__nameGap + datum.__nameContentSlot + datum.__colGap + datum.__valueFullSlot + datum.__legendRightMargin)",
   "as": "__tier1Req"
  },
  {
   "calculate": "(datum.__dotInset + datum.__nameGap + datum.__nameContentSlot + datum.__colGap + datum.__valueCountSlot + datum.__legendRightMargin)",
   "as": "__tier2Req"
  },
  {
   "calculate": "(datum.__dotInset + datum.__nameGap + datum.__nameContentSlot + datum.__legendRightMargin)",
   "as": "__tier3Req"
  },
  {
   "calculate": "(datum.__tier1Req <= legendWCeiling ? 1 : datum.__tier2Req <= legendWCeiling ? 2 : datum.__tier3Req <= legendWCeiling ? 3 : 4)",
   "as": "__legendTierSide"
  },
  {
   "calculate": "max(1, floor(width / datum.__tier1Req))",
   "as": "__itemsPerRow1"
  },
  {
   "calculate": "max(1, floor(width / datum.__tier2Req))",
   "as": "__itemsPerRow2"
  },
  {
   "calculate": "max(1, floor(width / datum.__tier3Req))",
   "as": "__itemsPerRow3"
  },
  {
   "calculate": "ceil(datum.__legendRows / datum.__itemsPerRow1)",
   "as": "__rows1"
  },
  {
   "calculate": "ceil(datum.__legendRows / datum.__itemsPerRow2)",
   "as": "__rows2"
  },
  {
   "calculate": "ceil(datum.__legendRows / datum.__itemsPerRow3)",
   "as": "__rows3"
  },
  {
   "calculate": "datum.__rows1 * datum.__legendRowH",
   "as": "__blockH1"
  },
  {
   "calculate": "datum.__rows2 * datum.__legendRowH",
   "as": "__blockH2"
  },
  {
   "calculate": "datum.__rows3 * datum.__legendRowH",
   "as": "__blockH3"
  },
  {
   "calculate": "(datum.__blockH1 <= legendHCeiling ? 1 : datum.__blockH2 <= legendHCeiling ? 2 : datum.__blockH3 <= legendHCeiling ? 3 : 4)",
   "as": "__legendTierBand"
  },
  {
   "calculate": "isNoLegend ? 4 : (isBandLegend ? datum.__legendTierBand : datum.__legendTierSide)",
   "as": "__legendTier"
  },
  {
   "calculate": "(datum.__legendTier == 1 ? datum.__valueFullSlot : datum.__legendTier == 2 ? datum.__valueCountSlot : 0)",
   "as": "__valueSlot"
  },
  {
   "calculate": "(datum.__legendTier == 1 ? datum.__tier1Req : datum.__legendTier == 2 ? datum.__tier2Req : datum.__legendTier == 3 ? datum.__tier3Req : 0)",
   "as": "__legendZoneWContent"
  },
  {
   "calculate": "isSideLegend ? min(datum.__legendZoneWContent, legendWCeiling) : 0",
   "as": "__legendZoneW"
  },
  {
   "calculate": "(datum.__legendTier == 1 ? datum.__itemsPerRow1 : datum.__legendTier == 2 ? datum.__itemsPerRow2 : datum.__legendTier == 3 ? datum.__itemsPerRow3 : 1)",
   "as": "__itemsPerRowChosen"
  },
  {
   "calculate": "(datum.__legendTier == 1 ? datum.__rows1 : datum.__legendTier == 2 ? datum.__rows2 : datum.__legendTier == 3 ? datum.__rows3 : 1)",
   "as": "__rowsChosen"
  },
  {
   "calculate": "datum.__legendZoneWContent",
   "as": "__itemContentWChosen"
  },
  {
   "calculate": "datum.__rowsChosen * datum.__legendRowH",
   "as": "__legendZoneHContent"
  },
  {
   "calculate": "isBandLegend ? min(datum.__legendZoneHContent, legendHCeiling) : 0",
   "as": "__legendZoneH"
  },
  {
   "calculate": "(isSideLegend ? (width - datum.__legendZoneW - zoneGap) : width) / 2",
   "as": "__maxRByWidth"
  },
  {
   "calculate": "(isBandLegend ? (height - datum.__legendZoneH - zoneGap) : height) / 2",
   "as": "__maxRByHeight"
  },
  {
   "calculate": "max(10, donutScale * (min(datum.__maxRByWidth, datum.__maxRByHeight) - ringMargin))",
   "as": "__outerR"
  },
  {
   "calculate": "datum.__outerR * (1 - donutThickness)",
   "as": "__innerR"
  },
  {
   "calculate": "(datum.__outerR + datum.__innerR) / 2",
   "as": "__labelRadius"
  },
  {
   "calculate": "2 * datum.__outerR + (isSideLegend ? zoneGap + datum.__legendZoneW : 0)",
   "as": "__contentW"
  },
  {
   "calculate": "2 * datum.__outerR + (isBandLegend ? zoneGap + datum.__legendZoneH : 0)",
   "as": "__contentH"
  },
  {
   "calculate": "(width - datum.__contentW) / 2",
   "as": "__contentX0"
  },
  {
   "calculate": "(height - datum.__contentH) / 2",
   "as": "__contentY0"
  },
  {
   "calculate": "legendPosition == 'left' ? (datum.__contentX0 + datum.__legendZoneW + zoneGap + datum.__outerR) : (datum.__contentX0 + datum.__outerR)",
   "as": "__donutX"
  },
  {
   "calculate": "legendPosition == 'top' ? (datum.__contentY0 + datum.__legendZoneH + zoneGap + datum.__outerR) : (datum.__contentY0 + datum.__outerR)",
   "as": "__donutY"
  },
  {
   "calculate": "legendPosition == 'left' ? datum.__contentX0 : (datum.__contentX0 + 2 * datum.__outerR + zoneGap)",
   "as": "__legendZoneX0"
  },
  {
   "calculate": "legendPosition == 'top' ? datum.__contentY0 : (datum.__contentY0 + 2 * datum.__outerR + zoneGap)",
   "as": "__legendZoneY0"
  },
  {
   "calculate": "clamp(datum.__innerR * 0.42, 11, 44)",
   "as": "__numberFontSizeAuto"
  },
  {
   "calculate": "datum.__numberFontSizeAuto * centerFontScaleEff",
   "as": "__numberFontSize"
  },
  {
   "calculate": "clamp(datum.__innerR * 0.20, 8, 18)",
   "as": "__captionFontSizeAuto"
  },
  {
   "calculate": "datum.__captionFontSizeAuto * centerFontScaleEff",
   "as": "__captionFontSize"
  },
  {
   "calculate": "(datum.__numberFontSize * 1.15 + 4 + datum.__captionFontSize * 1.3) <= (2 * datum.__innerR - 10)",
   "as": "__captionFits"
  },
  {
   "calculate": "datum.__donutY - datum.__captionFontSize * 0.62 - 2",
   "as": "__numberYWithCaption"
  },
  {
   "calculate": "datum.__donutY + datum.__numberFontSize * 0.46 + 4",
   "as": "__captionY"
  },
  {
   "calculate": "clamp((datum.__outerR) * 0.09, 9, 20)",
   "as": "__sliceLabelFontSizeAuto"
  },
  {
   "calculate": "datum.__sliceLabelFontSizeAuto * sliceLabelScaleEff",
   "as": "__sliceLabelFontSize"
  },
  {
   "calculate": "datum.__legendZoneX0 + datum.__dotInset",
   "as": "__legendXDotSide"
  },
  {
   "calculate": "datum.__legendXDotSide + datum.__nameGap",
   "as": "__legendXNameSide"
  },
  {
   "calculate": "datum.__legendZoneX0 + datum.__legendZoneW - datum.__legendRightMargin",
   "as": "__legendZoneRightEdge"
  },
  {
   "calculate": "datum.__legendXNameSide + datum.__nameContentSlot + datum.__colGap + datum.__valueSlot",
   "as": "__legendXValueTightSide"
  },
  {
   "calculate": "min(datum.__legendZoneRightEdge, datum.__legendXValueTightSide)",
   "as": "__legendXValueSide"
  },
  {
   "calculate": "max(20, (datum.__legendXValueSide - datum.__valueSlot - datum.__colGap) - datum.__legendXNameSide)",
   "as": "__nameSlotTier12"
  },
  {
   "calculate": "max(20, datum.__legendZoneW - datum.__dotInset - datum.__nameGap - datum.__legendRightMargin)",
   "as": "__nameSlotTier34"
  },
  {
   "calculate": "(datum.__legendTier >= 3 ? datum.__nameSlotTier34 : datum.__nameSlotTier12)",
   "as": "__nameSlotSide"
  },
  {
   "calculate": "min(datum.__legendZoneRightEdge, datum.__legendXNameSide + datum.__nameContentSlot + datum.__colGap + datum.__legendFontSize * 2.5)",
   "as": "__legendXCountSide"
  },
  {
   "calculate": "floor((datum.__legendRank - 1) / datum.__itemsPerRowChosen)",
   "as": "__rowIdx"
  },
  {
   "calculate": "(datum.__rowIdx == datum.__rowsChosen - 1 ? (datum.__legendRows - datum.__itemsPerRowChosen * (datum.__rowsChosen - 1)) : datum.__itemsPerRowChosen)",
   "as": "__itemsInThisRow"
  },
  {
   "calculate": "(datum.__legendRank - 1) % datum.__itemsPerRowChosen",
   "as": "__colIdx"
  },
  {
   "calculate": "datum.__itemsInThisRow * datum.__itemContentWChosen",
   "as": "__rowWidth"
  },
  {
   "calculate": "width / 2 - datum.__rowWidth / 2",
   "as": "__rowStartX"
  },
  {
   "calculate": "datum.__rowStartX + datum.__colIdx * datum.__itemContentWChosen",
   "as": "__itemAnchorX"
  },
  {
   "calculate": "datum.__itemAnchorX + datum.__dotInset",
   "as": "__legendXDotBand"
  },
  {
   "calculate": "datum.__legendXDotBand + datum.__nameGap",
   "as": "__legendXNameBand"
  },
  {
   "calculate": "datum.__itemAnchorX + datum.__itemContentWChosen - datum.__legendRightMargin",
   "as": "__legendXValueBand"
  },
  {
   "calculate": "max(20, (datum.__legendXValueBand - datum.__valueSlot - datum.__colGap) - datum.__legendXNameBand)",
   "as": "__nameSlotBandTier12"
  },
  {
   "calculate": "max(20, datum.__itemContentWChosen - datum.__dotInset - datum.__nameGap - datum.__legendRightMargin)",
   "as": "__nameSlotBandTier34"
  },
  {
   "calculate": "(datum.__legendTier >= 3 ? datum.__nameSlotBandTier34 : datum.__nameSlotBandTier12)",
   "as": "__nameSlotBand"
  },
  {
   "calculate": "isBandLegend ? datum.__legendXDotBand : datum.__legendXDotSide",
   "as": "__legendXDot"
  },
  {
   "calculate": "isBandLegend ? datum.__legendXNameBand : datum.__legendXNameSide",
   "as": "__legendXName"
  },
  {
   "calculate": "isBandLegend ? datum.__legendXValueBand : datum.__legendXValueSide",
   "as": "__legendXValue"
  },
  {
   "calculate": "isBandLegend ? datum.__legendXValueBand : datum.__legendXCountSide",
   "as": "__legendXCount"
  },
  {
   "calculate": "isBandLegend ? datum.__legendXValueBand : datum.__legendZoneRightEdge",
   "as": "__legendXPct"
  },
  {
   "calculate": "isBandLegend ? datum.__nameSlotBand : datum.__nameSlotSide",
   "as": "__nameSlot"
  },
  {
   "calculate": "(datum.__donutY) + (datum.__legendRank - (datum.__legendCount + 1) / 2) * (datum.__legendRowH)",
   "as": "__legendYSide"
  },
  {
   "calculate": "(datum.__legendZoneY0) + (datum.__rowIdx + 0.5) * (datum.__legendRowH)",
   "as": "__legendYBand"
  },
  {
   "calculate": "isBandLegend ? datum.__legendYBand : datum.__legendYSide",
   "as": "__legendY"
  },
  {
   "calculate": "datum.__legendTier == 1 ? (showPercent ? datum.__countText + ' (' + datum.__pctText + ')' : datum.__countText) : datum.__legendTier == 2 ? datum.__countText : ''",
   "as": "__inlineText"
  },
  {
   "calculate": "legendLayout == 'inline' ? datum.__inlineText : ''",
   "as": "__inlineTextDisplay"
  },
  {
   "calculate": "(legendLayout == 'columns' && datum.__legendTier <= 2) ? datum.__countText : ''",
   "as": "__countColumnDisplay"
  },
  {
   "calculate": "(legendLayout == 'columns' && datum.__legendTier == 1) ? datum.__pctTextDisplay : ''",
   "as": "__pctColumnDisplay"
  },
  {
   "calculate": "((showSliceLabels || datum.__legendTier == 4) && datum.__pct >= 0.04) ? datum.__pctText : ''",
   "as": "__sliceLabelText"
  },
  {
   "window": [
    {
     "op": "rank",
     "as": "__anyRank"
    }
   ],
   "sort": [
    {
     "field": "__groupKey",
     "order": "ascending"
    }
   ]
  },
  {
   "calculate": "centerText",
   "as": "__centerTextPass0"
  },
  {
   "calculate": "replace(datum.__centerTextPass0, /\\{total\\}/g, format(datum.__totalValue, ',.0f'))",
   "as": "__centerTextPass1"
  },
  {
   "calculate": "replace(datum.__centerTextPass1, /\\{count\\}/g, format(datum.__displayCount, ',.0f'))",
   "as": "__centerTextPass2"
  },
  {
   "calculate": "replace(datum.__centerTextPass2, /\\{avg\\}/g, format(datum.__totalValue / datum.__displayCount, ',.0f'))",
   "as": "__centerTextPass3"
  },
  {
   "calculate": "replace(datum.__centerTextPass3, /\\{max\\}/g, format(datum.__maxGroupValue, ',.0f'))",
   "as": "__centerTextPass4"
  },
  {
   "calculate": "replace(datum.__centerTextPass4, /\\{maxName\\}/g, datum.__argmaxGroupRow.__groupKey)",
   "as": "__centerTextResolved"
  },
  {
   "calculate": "datum.__anyRank != 1 ? '' : (centerMode == 'sum' ? format(datum.__totalValue, ',.0f') : centerMode == 'custom' ? datum.__centerTextResolved : '')",
   "as": "__centerNumberText"
  },
  {
   "calculate": "datum.__anyRank != 1 ? '' : ((centerMode == 'sum' || centerMode == 'custom') && (datum.__captionFits) ? centerCaption : '')",
   "as": "__centerCaptionText"
  },
  {
   "calculate": "colorOverrides[datum.__groupKey] ? colorOverrides[datum.__groupKey] : (datum.__isOther ? otherColor : (length(palette) > 0 ? palette[(datum.__legendRank - 1) % length(palette)] : pbiColor(datum.__legendRank - 1)))",
   "as": "__color"
  },
  {
   "calculate": "luminance(datum.__color) >= 0.45 ? '#252423' : '#FFFFFF'",
   "as": "__sliceLabelColor"
  }
 ],
