{
  "name": "5d0c7c1e-0000-4000-8000-000000000001",
  "id": "/providers/Microsoft.Flow/flows/5d0c7c1e-0000-4000-8000-000000000001",
  "type": "Microsoft.Flow/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "แจ้งเตือนสัญญาใกล้หมด",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": { "$connections": { "defaultValue": {}, "type": "Object" }, "$authentication": { "defaultValue": {}, "type": "SecureObject" } },
      "triggers": {
        "Recurrence": { "recurrence": { "frequency": "Day", "interval": 1, "timeZone": "SE Asia Standard Time" }, "type": "Recurrence" }
      },
      "actions": {
        "Get_items": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "shared_sharepointonline", "operationId": "GetItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" },
            "parameters": { "dataset": "https://contoso.sharepoint.com/sites/SECRET-SITE-7731", "table": "b3a1c6f0-SECRET-LIST-ID" },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Call_webhook": {
          "runAfter": { "Get_items": ["Succeeded"] },
          "type": "Http",
          "inputs": { "method": "POST", "uri": "https://prod-00.southeastasia.logic.azure.com/workflows/SECRETWORKFLOW/triggers/manual/paths/invoke?sig=SECRETSIG123",
            "headers": { "Authorization": "Bearer SECRET-TOKEN-XYZ" }, "body": { "to": "secret.person@example.com" } }
        },
        "Send_an_email_(V2)": {
          "runAfter": { "Call_webhook": ["Succeeded"] },
          "type": "OpenApiConnection",
          "description": "ส่งเมลแจ้งผู้ดูแล",
          "inputs": { "host": { "connectionName": "shared_office365" },
            "parameters": { "emailMessage/To": "secret.person@example.com", "emailMessage/Subject": "SECRET-SUBJECT", "emailMessage/Body": "<p>password: hunter2-SECRET</p>" } },
          "metadata": { "operationMetadataId": "7f0c2d4e-SECRET-META" }
        },
        "Check_status": {
          "runAfter": { "Send_an_email_(V2)": ["Succeeded"] },
          "type": "If",
          "expression": { "equals": ["@body('Call_webhook')?['status']", "SECRET-EXPR-VALUE"] },
          "actions": {},
          "else": { "actions": { "Log_failure": { "runAfter": {}, "type": "Compose", "inputs": "SECRET-COMPOSE-VALUE" } } }
        },
        "Route": {
          "runAfter": { "Check_status": ["Succeeded"] },
          "type": "Switch",
          "expression": "@variables('SECRET-VAR')",
          "cases": { "Case": { "case": "SECRET-CASE-VALUE", "actions": { "Compose_a": { "runAfter": {}, "type": "Compose", "inputs": "x" } } } },
          "default": { "actions": {} }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_office365": { "connectionName": "shared-office365-SECRETCONN-4f1b", "source": "Embedded", "id": "/providers/Microsoft.PowerApps/apis/shared_office365", "tier": "NotSpecified" }
    },
    "flowFailureAlertSubscribed": false
  }
}
